# Base CLI tools deployed by tasks/bootstrap.py.
# Edit and re-run the deploy to add/remove tools.

brew "fish"
brew "git"
brew "curl"
brew "wget"
brew "htop"
brew "jq"
brew "ripgrep"
brew "fd"
brew "tmux"
brew "vim"
brew "zoxide"
# uv — used by tasks/comfyui.py to build /Applications/ComfyUI/.venv from
# the upstream requirements.txt. Provides a hermetic Python toolchain
# independent of system python and any user-level pyenv state.
brew "uv"
# cmake — tasks/whisper.py builds whisper.cpp's HTTP server from source
# because the Homebrew whisper-cpp formula disables it via
# -DWHISPER_BUILD_SERVER=OFF (it only ships whisper-cli).
brew "cmake"

# Service binaries — pinned by their own tasks/*.py for version control.
# Listed here so brew tracks them; the launchd plist owns lifecycle.
brew "caddy"
# Ollama is intentionally NOT brew — Homebrew builds ship without parts of the
# image-gen runtime that the official Ollama.app bundles. tasks/ollama.py
# downloads the Ollama-darwin.zip release from GitHub and points the
# LaunchDaemon at /Applications/Ollama.app/Contents/Resources/ollama.
